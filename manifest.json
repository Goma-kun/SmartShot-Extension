{
  "manifest_version": 3,
  "name": "SmartShot",
  "version": "0.3.1",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": ["activeTab", "storage", "downloads", "scripting", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "take-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "__MSG_commandDescription__"
    }
  }
}
